	partition Aging_Clientes_Snapshot = calculated
		mode: import
		source =
				
				VAR FechasCorte =
				    CALENDAR(
				        DATE(2026, 1, 1),
				        DATE(2027, 12, 31)
				    )
				
				VAR Facturas =
				    SELECTCOLUMNS(
				        '200 Aging_Clientes',
				        "ID_aging",
				            '200 Aging_Clientes'[NIF]&'200 Aging_Clientes'[Nº Factura]&INT('200 Aging_Clientes'[F. Vto.]),
				        "NIF", '200 Aging_Clientes'[NIF],
				        "Nº Factura", '200 Aging_Clientes'[Nº Factura],
				        "F.Factura", '200 Aging_Clientes'[F.Factura],
				        "F.Vto", '200 Aging_Clientes'[F. Vto.],
				        "Nombre cliente", '200 Aging_Clientes'[Nombre Cliente],
				        "Saldo Pend", '200 Aging_Clientes'[S_Pendiente],
				        "Proveedor", '200 Aging_Clientes'[Proveedor]
				    )
				
				VAR Base =
				    FILTER(
				        CROSSJOIN(
				            FechasCorte,
				            Facturas
				        ),
				        [F.Factura] <= [Date]
				    )
				
				RETURN
				ADDCOLUMNS(
				    Base,
				
				    "DaysDue",
				        VAR FechaCorte = [Date]
				        VAR FechaVto = [F.Vto]
				        RETURN
				            IF(
				                ISBLANK(FechaVto),
				                BLANK(),
				                DATEDIFF(
				                    FechaVto,
				                    FechaCorte,
				                    DAY
				                )
				            ),
				
				    "AgingBucket",
				        VAR FechaCorte2 = [Date]
				        VAR FechaVto2 = [F.Vto]
				
				        VAR Dias =
				            IF(
				                ISBLANK(FechaVto2),
				                BLANK(),
				                DATEDIFF(
				                    FechaVto2,
				                    FechaCorte2,
				                    DAY
				                )
				            )
				
				        RETURN
				            SWITCH(
				                TRUE(),
				                ISBLANK(Dias), BLANK(),
				                Dias <= 0,   "A- NOT DUE",
				                Dias <= 30,  "B- 0-30 Days",
				                Dias <= 60,  "C- 31-60 Days",
				                Dias <= 90,  "D- 61-90 Days",
				                Dias <= 120, "E- 90-120 Days",
				                Dias <= 180, "F- 121-180 Days",
				                Dias <= 365, "G- 181-365 Days",
				                "H- Over 1 Year"
				            )
				)

	annotation PBI_Id = d01e0cc2e25a47bf93816055895ce9ce

