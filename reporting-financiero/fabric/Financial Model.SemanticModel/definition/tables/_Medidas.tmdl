			    )
			
			VAR Resultado =
			    SUMX (
			        MapeoFila,
			        VAR CuentaActual =
			            Map_Report_Line_Account[Cuenta]
			
			        VAR FactorActual =
			            [Factor]
			
			        RETURN
			            FactorActual
			                * CALCULATE (
			                    [Importe Base],
			                    REMOVEFILTERS (
			                        Dim_Mapeo_Cuentas[Cuenta_magnitude]
			                    ),
			                    TREATAS (
			                        { CuentaActual },
			                        Dim_Mapeo_Cuentas[Cuenta_magnitude]
			                    )
			                )
