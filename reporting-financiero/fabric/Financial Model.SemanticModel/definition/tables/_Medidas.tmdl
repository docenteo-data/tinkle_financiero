	measure 'Estado GI' =
			
			VAR Real = [Gross Income Real]
			VAR MMS_ = [Gross income MMS]
			VAR Dif = [Desviación Gross Income]
			RETURN
			    SWITCH (
			        TRUE(),
			        ISBLANK(Real) && ISBLANK(MMS_), BLANK(),
			        COALESCE(MMS_, 0) = 0 && COALESCE(Real, 0) <> 0, "Solo Real",
			        COALESCE(Real, 0) = 0 && COALESCE(MMS_, 0) <> 0, "Solo MMS",
			        ABS(Dif) < 1, "Cuadra",
			        Dif > 0, "Real > MMS",
			        "MMS > Real"
			    )
		lineageTag: 3ebd67c9-140e-4d3a-bad1-bb0c913c6d19

