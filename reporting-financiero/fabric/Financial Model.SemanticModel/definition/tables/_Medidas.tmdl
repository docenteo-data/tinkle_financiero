	measure 2026_Coste_total_salarial = [2026_salario_total]+[Coste SSGG 2026]
		formatString: #,0.00
		lineageTag: d53a6e8d-9de4-477c-a14a-f4c1bc1e998e

	measure 2026_salario = SUM(Dim_RRHH[SALARIO ANUAL 2026])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: cf140fca-dbd3-4f04-8df9-f48d83babe80

	measure 'Coste SSGG 2026' =
			
			VAR Salario = [2026_salario_total]
			RETURN
			    IF(
			        ISBLANK(Salario),
			        BLANK(),
			        MIN(Salario, 61214.4) * 0.3227
			            + MIN(MAX(Salario - 61214.4, 0), 6121.44) * 0.0115
			            + MIN(MAX(Salario - 67335.84, 0), 24485.76) * 0.0125
			            + MAX(Salario - 91821.6, 0) * 0.0146
			    )
		lineageTag: b7ef6a4e-2714-4efa-b8a3-2c8424fdb8e1

	measure 2026_salario_total = [2026_salario]+SUM(Dim_RRHH[IPC 2026 _INCLUIDO MEDIANA DE 2025 HASTA CONFIRMACION_])+SUM(Dim_RRHH[SUBIDA SALARIAL 2026])
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 95a14ac2-d137-4681-97ce-4e0f181cb200

	measure 'Coste SSGG Bonus 2025' =
			
			VAR Bonus = SUM(Dim_RRHH[Bonus 2025])
			RETURN
			    IF(
			        ISBLANK(Bonus),
			        BLANK(),
			        MIN(Bonus, 61214.4) * 0.3227
			            + MIN(MAX(Bonus - 61214.4, 0), 6121.44) * 0.0115
			            + MIN(MAX(Bonus - 67335.84, 0), 24485.76) * 0.0125
			            + MAX(Bonus - 91821.6, 0) * 0.0146
			    )
		lineageTag: 0a7913ed-43da-4ec4-8d76-14c58e71b027

		annotation PBI_FormatHint = {"isGeneralNumber":true}

