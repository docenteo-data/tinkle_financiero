	measure 'Color Fondo Reporting' =
			
			VAR FilaOriginal =
			    SELECTEDVALUE ( Dim_Report_Line[Etiqueta] )
			
			VAR Fila =
			    TRIM (
			        SUBSTITUTE (
			            FilaOriginal,
			            UNICHAR ( 160 ),
			            " "
			        )
			    )
			
			RETURN
			    SWITCH (
			        TRUE (),
			
			        // =====================================================
			        // ASSETS
			        // =====================================================
			        Fila IN {
			            "ST-A110 Authorised Capital - Uncalled up",
			            "ST-A120B Intangible Fixed Assets",
			            "ST-A120D A/P Intangible Assets",
			            "ST-A140B Tangible Assets",
			            "ST-A140D Tangible Assets Depreciation",
			            "ST-A160B Financial Assets",
			            "ST-A160D Prov. for depreciation of financial assets",
			            "ST-A210B Inventories & Work in progress",
			            "ST-A210D Provisions/Inventories & WIP",
			            "ST-A220B Other receivables",
			            "ST-A220D Prov. other receivables",
			            "ST-A240B Marketable Securities",
			            "ST-A240D Prov/Marketable Securities",
			            "ST-A250 Cash",
			            "ST-A250D Prov. for cash unavailable",
			            "ST-A300 Accruals - Assets"
			        },
			        "#D9E1F2",
			
			        // =====================================================
			        // LIABILITIES
			        // =====================================================
			        Fila IN {
			            "ST-P110 Shareholders Equity",
			            "ST-P200 Other Equity Capital",
			            "ST-P410 Provisions for risks",
			            "ST-P420 Provisions For Charges",
			            "ST-P510 Financial Debts (except overdraft)",
			            "ST-P520 Overdraft",
			            "ST-P610 Accounts payable and other liabilities",
			            "ST-P700 Accruals - Liabilities",
			
			            // Filas destacadas en azul en el checklist
			            "P44200 - Tax consolidation payables",
			            "P44400 - Income tax payable"
			        },
			        "#D9E1F2",
			
			        // =====================================================
			        // P&L
			        // =====================================================
			        Fila IN {
			            "ST-R111 Turnover",
			
			            "Clients costs and coordinatioin fees",
			            "Revenue IFRS15",
			            "Pass trough costs",
			            "GROSS INCOME",
			
			            "ST-R124 Compensation",
			            "ST-R122 External services",
			            "ST-R123 Taxes",
			            "ST-R125 Other Operating expenses",
			            "ST-R112 Other Operating income",
			
			            "ST-R130D Operating allowances",
			            "ST-R130R Operating write-backs",
			            "Operating Expenses",
			            "OPERATING PROFIT",
			
			            "ST-R210 Financial income",
			            "ST-R220 Financial expenses",
			            "ST-R230D Financial allowances",
			            "ST-R230R Write-back on Financial allowances",
			            "FINANCIAL INCOME",
			
			            "Exceptional revenues",
			            "Exceptional expenses",
			            "NON OPERATING ITEMS INCOME NET",
			
			            "R69500 - Corporate tax - At current rate",
			            "R69800 - Tax income/expense tied to tax consolidation",
			
			            "ST-R520 Income tax"
			        },
			        "#D9E1F2",
			
			        // =====================================================
			        // TOTALES
			        // =====================================================
			        Fila IN {
			            "Total Assets",
			            "Total Liabilities and equity",
			            "Total Net Income"
			        },
			        "#FFF2CC",
			
			        BLANK ()
			    )
		lineageTag: 5bc836c5-0cfa-45dc-bcda-8a32594218e3

