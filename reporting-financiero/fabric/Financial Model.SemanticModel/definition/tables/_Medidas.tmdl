	measure 'Estado Dedicación Persona' =
			
			VAR Pct = [% Dedicación Total Persona]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Pct ), "Sin asignación",
			        ABS ( Pct - 1 ) <= 0.001, "OK",
			        Pct < 1, "< 100%",
			        Pct > 1, "> 100%"
			    )
