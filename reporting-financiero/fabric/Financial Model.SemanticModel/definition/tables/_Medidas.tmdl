table _Medidas
	lineageTag: 50dd12e7-db1a-4bfe-885c-5ec89b189338

	measure 'ASOC01 - Statutory data' =
			
			VAR ResultadoCuentas =
			    [Importe Reporting Cuentas]
			
			VAR MapeoMedidas =
			    SUMMARIZE (
			        FILTER (
			            Map_Report_Line_Account,
			            Map_Report_Line_Account[Tipo_Origen] = "Medida"
			        ),
			        Map_Report_Line_Account[Referencia],
			        "Factor", SUM ( Map_Report_Line_Account[Signo] )
			    )
			
			VAR ResultadoMedidas =
			    SUMX (
			        MapeoMedidas,
			        VAR ReferenciaActual =
			            Map_Report_Line_Account[Referencia]
			
			        VAR FactorActual =
			            [Factor]
			
			        RETURN
			            SWITCH (
			                ReferenciaActual,
			                "NET_INCOME", FactorActual * [Net Income Reporting],
			                0
			            )
			    )
			
			RETURN
			    COALESCE (
			        ResultadoCuentas + ResultadoMedidas,
			        0
			    )
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: bad442e8-0615-4df8-8dbb-b061a1f40edb

	measure FCT =
			
			VAR ResultadoCuentas =
			    [Budget Reporting Cuentas]
			
			VAR MapeoMedidas =
			    SUMMARIZE (
			        FILTER (
			            Map_Report_Line_Account,
			            Map_Report_Line_Account[Tipo_Origen] = "Medida"
			        ),
			        Map_Report_Line_Account[Referencia],
			        "Factor", SUM ( Map_Report_Line_Account[Signo] )
			    )
			
			VAR ResultadoMedidas =
			    SUMX (
			        MapeoMedidas,
			        VAR ReferenciaActual =
			            Map_Report_Line_Account[Referencia]
			        VAR FactorActual =
			            [Factor]
			        RETURN
			            SWITCH (
			                ReferenciaActual,
			                "NET_INCOME",
			                    FactorActual * [Budget Net Income],
			                0
			            )
			    )
			
			VAR Resultado =
			    COALESCE (
			        ResultadoCuentas + ResultadoMedidas,
			        0
			    )
			
			RETURN
			    -Resultado
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 43da7955-82ae-4cc3-b491-8d30eb59475f

	measure 'Budget Base' =
			
			VAR _BudgetMiles =
			    SUM(Presupuestos[Valor])
			
			VAR _Escala =
			    [Escala Seleccionado]
			
			RETURN
			    _BudgetMiles * DIVIDE(1000, _Escala)
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: ec958772-54ca-4572-9cc8-b6298d84418b

	measure 'Budget Net Income' =
			
			VAR NetIncomeKey =
			    CALCULATE (
			        SELECTEDVALUE ( Dim_Report_Line[Report_Line_Key] ),
			        REMOVEFILTERS ( Dim_Report_Line ),
			        Dim_Report_Line[Reporte] = "P&L",
			        Dim_Report_Line[Fila_Excel] = 241
			    )
			
			RETURN
			    CALCULATE (
			        [Budget Reporting Cuentas],
			        REMOVEFILTERS ( Dim_Report_Line ),
			        TREATAS (
			            { NetIncomeKey },
			            Dim_Report_Line[Report_Line_Key]
			        )
			    )
		lineageTag: ec829358-c45d-420b-835e-c05ae91c7abe

	measure 'Budget Reporting Cuentas' =
			
			VAR MapeoFila =
			    SUMMARIZE (
			        FILTER (
			            Map_Report_Line_Account,
			            Map_Report_Line_Account[Tipo_Origen] = "Cuenta"
			        ),
			        Map_Report_Line_Account[Cuenta],
			        "Factor", SUM ( Map_Report_Line_Account[Signo] )
			    )
			
			VAR Resultado =
			    SUMX (
			        MapeoFila,
			
			        VAR CuentaActual =
			            Map_Report_Line_Account[Cuenta]
			
			        VAR FactorActual =
			            [Factor]
			
			        RETURN
			            FactorActual
			                * CALCULATE (
			                    [Budget Base],
			                    TREATAS (
			                        { CuentaActual },
			                        Presupuestos[Cuenta]
			                    )
			                )
			    )
			
			RETURN
			    COALESCE ( Resultado, 0 )
		lineageTag: 70f92e1c-dcb5-45a8-b5aa-8187eb8f9b5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

