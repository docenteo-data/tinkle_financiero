          "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
          "references": {
            "measures": [
              {
                "entity": "_Medidas",
                "name": "Importe Base"
              }
            ]
          }
        },
        {
          "name": "Acordado anual",
          "dataType": "Double",
          "expression": "SUM(MMS[IMPORTE])-[REAL (Fees & other)]",
          "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\"",
          "references": {
            "measures": [
              {
                "schema": "extension",
                "entity": "_Medidas",
                "name": "REAL (Fees & other)"
              }
            ]
          }
        },
        {
          "name": "Importe MMS",
          "dataType": "Double",
          "expression": "SUM(MMS[IMPORTE])",
          "formatString": "#,0.00\\ \"€\";-#,0.00\\ \"€\";#,0.00\\ \"€\""
        }
      ]
    }
  ]
