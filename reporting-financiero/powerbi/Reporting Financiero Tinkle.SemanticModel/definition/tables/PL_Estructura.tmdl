table PL_Estructura
	lineageTag: e079de09-2b52-4801-86ab-b964603ee86e
	sourceLineageTag: ac1c7946-bfe4-4f41-93dc-f3d28d07362f

	measure 'Importe P&L Niveles' =
			
			VAR PLIDsBaseEnContexto =
			    CALCULATETABLE (
			        VALUES ( PL_Estructura[PL_ID] ),
			        KEEPFILTERS ( PL_Estructura[Tipo_Linea] = "Base" )
			    )
			RETURN
			CALCULATE (
			    [Importe Base],
			    REMOVEFILTERS ( PL_Estructura ),
			    TREATAS (
			        PLIDsBaseEnContexto,
			        PL_Mapping_Cuentas[PL_ID]
			    )
			)
		lineageTag: ab3200a3-d465-4e9e-b6fa-0f49f397e685

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

