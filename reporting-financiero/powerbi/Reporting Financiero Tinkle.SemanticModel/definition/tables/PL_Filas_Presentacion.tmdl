				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Orden = _t, Linea_Matriz = _t, Tipo_Fila = _t, Cuenta_SAP = _t, PL_ID = _t]),
				  #"Tipo de columna cambiado" = Table.TransformColumnTypes(Origen, {{"Orden", Int64.Type}, {"Linea_Matriz", type text}, {"Tipo_Fila", type text}, {"Cuenta_SAP", type text}, {"PL_ID", Int64.Type}}, "es")
