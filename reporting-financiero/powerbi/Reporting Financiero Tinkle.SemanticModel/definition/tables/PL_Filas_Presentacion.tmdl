table PL_Filas_Presentacion
	lineageTag: 1e2798d0-c06a-45e5-b89e-6264c33995ca

	measure 'Importe P&L Presentacion' =
			
			VAR TipoFila =
			    SELECTEDVALUE ( PL_Filas_Presentacion[Tipo_Fila] )
			
			VAR CuentaSAP =
			    SELECTEDVALUE ( PL_Filas_Presentacion[Cuenta_SAP] )
			
			VAR PLID =
			    SELECTEDVALUE ( PL_Filas_Presentacion[PL_ID] )
			
			VAR ImporteCuenta =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            { CuentaSAP },
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR Turnover =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 10 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR ClientCosts =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 20 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR RevenueIFRS15 =
			    Turnover + ClientCosts
			
			VAR PassThroughCosts =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 40 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR GrossIncome =
			    RevenueIFRS15 + PassThroughCosts
			
			VAR Compensation =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 100 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR ExternalServices =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 110 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR Taxes =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 120 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR OtherOperatingExpenses =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 130 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR OtherOperatingIncome =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 140 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR OperatingAllowances =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 150 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR OperatingWriteBacks =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 160 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR OperatingExpenses =
			    Compensation
			        + ExternalServices
			        + Taxes
			        + OtherOperatingExpenses
			        + OtherOperatingIncome
			        + OperatingAllowances
			        + OperatingWriteBacks
			
			VAR OperatingProfit =
			    GrossIncome + OperatingExpenses
			
			VAR FinancialIncomeDetail =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 200 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR FinancialExpenses =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 210 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR FinancialAllowances =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 220 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR WriteBackFinancialAllowances =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 230 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR FinancialIncome =
			    FinancialIncomeDetail
			        + FinancialExpenses
			        + FinancialAllowances
			        + WriteBackFinancialAllowances
			
			VAR ExceptionalRevenues =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 300 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR ExceptionalExpenses =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 310 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR NonOperating =
			    ExceptionalRevenues + ExceptionalExpenses
			
			VAR IncomeTax =
			    CALCULATE (
			        [Importe Base],
			        TREATAS (
			            SELECTCOLUMNS (
			                FILTER ( PL_Mapping_Cuentas, PL_Mapping_Cuentas[PL_ID] = 400 ),
			                "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			            ),
			            COA_Oracle[SAP-ACCOUINT]
			        )
			    )
			
			VAR TotalNetIncome =
			    OperatingProfit + FinancialIncome + NonOperating + IncomeTax
			
			RETURN
			SWITCH (
			    TRUE (),
			
			    TipoFila = "Cuenta", ImporteCuenta,
			
			    PLID = 10, Turnover,
			    PLID = 20, ClientCosts,
			    PLID = 30, RevenueIFRS15,
			    PLID = 40, PassThroughCosts,
			    PLID = 50, GrossIncome,
			
			    PLID = 100, Compensation,
			    PLID = 110, ExternalServices,
			    PLID = 120, Taxes,
			    PLID = 130, OtherOperatingExpenses,
			    PLID = 140, OtherOperatingIncome,
			    PLID = 150, OperatingAllowances,
			    PLID = 160, OperatingWriteBacks,
			    PLID = 170, OperatingExpenses,
			    PLID = 180, OperatingProfit,
			
			    PLID = 200, FinancialIncomeDetail,
			    PLID = 210, FinancialExpenses,
			    PLID = 220, FinancialAllowances,
			    PLID = 230, WriteBackFinancialAllowances,
			    PLID = 240, FinancialIncome,
			
			    PLID = 300, ExceptionalRevenues,
			    PLID = 310, ExceptionalExpenses,
			    PLID = 320, NonOperating,
			
			    PLID = 400, IncomeTax,
			    PLID = 500, TotalNetIncome,
			
			    BLANK ()
			)
		lineageTag: 82c263d7-6bc7-4313-a53f-96a338810b7a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Orden
		dataType: int64
		formatString: 0
		lineageTag: ece2c25d-cdc0-4375-8d05-d7c5fd4a109e
		summarizeBy: sum
		sourceColumn: Orden

