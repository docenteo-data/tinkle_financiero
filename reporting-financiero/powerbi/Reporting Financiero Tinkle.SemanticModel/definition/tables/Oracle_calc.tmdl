table Oracle_calc
	lineageTag: 168ada2d-1eeb-4acd-9948-5b8edc229349
	sourceLineageTag: 61b9475c-9fa2-4e82-a705-cec1b5c24267

	measure 'Importe Base' = SUM ( Oracle_calc[Total _Sum_] )
		lineageTag: ac35c5ff-0689-4901-9d3b-0a00d60bd4b2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe Línea Base' =
			
			VAR LineaActual =
			    SELECTEDVALUE ( PL_Estructura[PL_ID] )
			RETURN
			CALCULATE (
			    [Importe Base],
			    TREATAS (
			        SELECTCOLUMNS (
			            FILTER (
			                PL_Mapping_Cuentas,
			                PL_Mapping_Cuentas[PL_ID] = LineaActual
			            ),
			            "CuentaSAP", PL_Mapping_Cuentas[Cuenta]
			        ),
			        COA_Oracle[SAP-ACCOUINT]
			    )
			)
		lineageTag: 2dabb226-351e-4ad2-90a5-0b16e38e350e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe P&L' =
			
			VAR LineaActual =
			    SELECTEDVALUE ( PL_Estructura[PL_ID] )
			
			VAR EstoyEnCuentaSAP =
			    ISINSCOPE ( COA_Oracle[SAP-ACCOUINT])
			
			VAR EstoyEnCuentaOracle =
			    ISINSCOPE ( COA_Oracle[SAP-ACCOUINT])
			
			VAR ImporteBaseLinea =
			    [Importe Línea Base]
			
			VAR GrossIncome =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] IN { 10, 20, 40 }
			    )
			
			VAR RevenueIFRS15 =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] IN { 10, 20 }
			    )
			
			VAR OperatingExpenses =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] IN { 100, 110, 120, 130, 140, 150, 160 }
			    )
			
			VAR OperatingProfit =
			    GrossIncome + OperatingExpenses
			
			VAR FinancialIncome =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] IN { 200, 210, 220, 230 }
			    )
			
			VAR NonOperating =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] IN { 300, 310 }
			    )
			
			VAR IncomeTax =
			    CALCULATE (
			        [Importe Línea Base],
			        REMOVEFILTERS ( PL_Estructura ),
			        PL_Estructura[PL_ID] = 400
			    )
			
			VAR TotalNetIncome =
			    OperatingProfit + FinancialIncome + NonOperating + IncomeTax
			
			RETURN
			SWITCH (
			    TRUE(),
			
			    -- Si estás expandiendo cuentas, solo tiene sentido mostrar detalle en líneas base
			    EstoyEnCuentaSAP || EstoyEnCuentaOracle,
			        IF (
			            SELECTEDVALUE ( PL_Estructura[Tipo_Linea] ) = "Base",
			            [Importe Base],
			            BLANK ()
			        ),
			
			    LineaActual = 30, RevenueIFRS15,
			    LineaActual = 50, GrossIncome,
			    LineaActual = 170, OperatingExpenses,
			    LineaActual = 180, OperatingProfit,
			    LineaActual = 240, FinancialIncome,
			    LineaActual = 320, NonOperating,
			    LineaActual = 500, TotalNetIncome,
			
			    ImporteBaseLinea
			)
		lineageTag: 17439aee-d2b8-4fe0-82f7-23683efc7ff1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

